<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.14"/>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DAP.Core.Shared\DAP.Core.Shared.csproj"/>
    <ProjectReference Include="..\DAP.Clients\DAP.Clients.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <!-- 平台接口契约与实现已抽到 DAP.Clients，页面与代码后置不再逐个 using。 -->
    <Using Include="DAP.Clients"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MudBlazor" Version="9.14.0"/>
  </ItemGroup>

</Project>
