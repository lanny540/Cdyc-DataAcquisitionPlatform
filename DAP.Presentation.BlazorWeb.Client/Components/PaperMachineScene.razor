@* 钞纸机车间三维示意：设备与管线由三维坐标投影成 SVG，视角固定。
   数值来自确定性模拟器，每 5 秒采样一次；切走孪生视图时组件销毁、定时器停表。 *@
<div class="twin-board">
    <header class="twin-head">
        <div class="twin-identity">
            <span class="twin-live" aria-hidden="true"></span>
            <div>
                <div class="twin-title">@_snapshot.LineName</div>
                <div class="twin-subtitle">@_snapshot.LineCode · 钞纸工房 · 模拟数据每 5 秒刷新</div>
            </div>
        </div>

        <dl class="twin-kpis">
            @foreach (TwinMetric metric in _snapshot.KeyMetrics)
            {
                <div class="twin-kpi">
                    <dt>@metric.Label</dt>
                    <dd>@metric.DisplayValue<span>@metric.Unit</span></dd>
                </div>
            }
        </dl>

        <div class="twin-freshness">
            <span class="twin-badge">实时</span>
            <span>数据截至 @_snapshot.CapturedAt.ToString("HH:mm:ss")</span>
        </div>
    </header>

    <figure class="twin-scene">
        <svg class="scene-svg" viewBox="0 0 1200 460" preserveAspectRatio="xMidYMid meet"
             role="img" aria-label="钞纸机车间轴测示意：备浆、湿部、干部三段设备与纸幅走向">
            <g class="scene-model">
                @foreach (SceneShape shape in Scene)
                {
                    switch (shape)
                    {
                        case ScenePolygon polygon:
                            <polygon points="@polygon.Points" class="@polygon.CssClass"/>
                            break;
                        case ScenePolyline polyline:
                            <polyline points="@polyline.Points" class="@polyline.CssClass"/>
                            break;
                        case SceneEllipse ellipse:
                            <ellipse cx="@ellipse.Cx" cy="@ellipse.Cy" rx="@ellipse.Radius"
                                     ry="@ellipse.Radius" class="@ellipse.CssClass"/>
                            break;
                    }
                }
            </g>

            @* 引线先画，标注框后画，引线不会压住文字。 *@
            <g class="scene-leaders" aria-hidden="true">
                @foreach (SceneTag tag in Tags)
                {
                    <polyline points="@tag.LeaderPoints" class="scene-leader @tag.StageCss"/>
                    <circle cx="@tag.AnchorX" cy="@tag.AnchorY" r="3.2"
                            class="scene-anchor @tag.StageCss"/>
                }
            </g>

            <g class="scene-tags">
                @foreach (SceneTag tag in Tags)
                {
                    <g class="@tag.StageCss">
                        <rect x="@tag.BoxX" y="@tag.BoxY" width="124" height="40" rx="7"
                              class="scene-tag-box"/>
                        <SvgText X="@tag.NameX" Y="@tag.LineOneY" CssClass="scene-tag-name">@tag.Name</SvgText>
                        <SvgText X="@tag.CodeX" Y="@tag.LineOneY" Anchor="end"
                                 CssClass="scene-tag-code">@tag.Code</SvgText>
                        <SvgText X="@tag.MetricX" Y="@tag.LineTwoY"
                                 CssClass="scene-tag-label">@tag.MetricLabel</SvgText>
                        <SvgText X="@tag.ValueX" Y="@tag.LineTwoY" Anchor="end"
                                 CssClass="scene-tag-value">@tag.ValueText</SvgText>
                    </g>
                }
            </g>

            @* 页脚标尺：与地坪上的分区色块一一对应 *@
            <g class="scene-rulers" aria-hidden="true">
                @foreach (StageRuler ruler in StageRulers)
                {
                    <line x1="@ruler.X1Text" y1="386" x2="@ruler.X2Text" y2="386"
                          class="scene-stage-rule @ruler.CssClass"/>
                    <SvgText X="@ruler.CenterText" Y="404" Anchor="middle"
                             CssClass="@($"scene-stage-name {ruler.CssClass}")">@ruler.Name</SvgText>
                    <SvgText X="@ruler.CenterText" Y="418" Anchor="middle"
                             CssClass="scene-stage-note">@ruler.Note</SvgText>
                }
            </g>

            <SvgText X="1164" Y="442" Anchor="end" CssClass="scene-caption">
                轴测示意 · 视角固定 · 非等比例
            </SvgText>
        </svg>
    </figure>

    <footer class="twin-foot">
        <div class="twin-totals">
            <span class="twin-foot-label">本班累计</span>
            @foreach (TwinMetric metric in _snapshot.ShiftTotals)
            {
                <div class="twin-total">
                    <span>@metric.Label</span>
                    <strong>@metric.DisplayValue</strong>
                    <em>@metric.Unit</em>
                </div>
            }
        </div>
        <p class="twin-note">设备布置按工艺流程示意，数值为确定性模拟数据，仅用于界面联调。</p>
    </footer>
</div>
