@inject NavigationManager Nav

@code {
    /// <summary>
    /// 未认证时把浏览器送到登录页，并带上当前地址以便登录后跳回。
    ///
    /// 用 forceLoad 而不是客户端跳转：登录页不属于交互式路由的一部分，
    /// 走整页加载才能确保服务端重新判定身份并渲染干净的外壳。
    /// </summary>
    protected override void OnInitialized()
    {
        var relative = Nav.ToBaseRelativePath(Nav.Uri);
        var returnUrl = string.IsNullOrEmpty(relative) ? "/" : $"/{relative}";

        Nav.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(returnUrl)}", forceLoad: true);
    }
}
