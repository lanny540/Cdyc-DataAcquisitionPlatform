@page "/park-energy/meters"

<PageTitle>计量点台账</PageTitle>

<MudStack Class="platform-page-shell" Spacing="2">
    <MudPaper Class="platform-page-hero platform-accent-secondary pa-4" Elevation="0">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap"
                  Spacing="3">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h4" GutterBottom="true">计量点台账</MudText>
                <MudText Typo="Typo.body1">
                    每块表登记介质、组织、用途与设备系统四项标签，读数进来才有归属。
                </MudText>
                <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" Class="mt-2">
                    <MudChip T="string" Variant="Variant.Outlined" Color="Color.Secondary">
                        @($"{_meters.Count} 个计量点")
                    </MudChip>
                    <MudChip T="string" Variant="Variant.Outlined" Color="Color.Info">
                        @($"{_meters.Count(meter => meter.IsEnabled)} 个启用")
                    </MudChip>
                </MudStack>
            </MudStack>
            <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync" Disabled="_isLoading">
                    刷新
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreate" Disabled="_dictionary is null">
                    新建计量点
                </MudButton>
            </MudStack>
        </MudStack>
    </MudPaper>

    @if (_message is not null)
    {
        <MudAlert Severity="@_messageSeverity" Dense="true" Variant="Variant.Outlined" CloseIconClicked="ClearMessage"
                  ShowCloseIcon="true">
            @_message
        </MudAlert>
    }

    <MudPaper Class="platform-section-card platform-section-card--tinted platform-accent-secondary pa-4"
              Elevation="0">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <span class="platform-section-icon">
                <MudIcon Icon="@Icons.Material.Filled.FormatListBulleted" Size="Size.Small"/>
            </span>
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6" Class="platform-card-title">台账明细</MudText>
                <MudText Typo="Typo.body2" Class="platform-card-description">
                    累计表（电表）按首末示数差算用量，非累计表（流量计）的读数本身即区间用量。
                </MudText>
            </MudStack>
        </MudStack>

        @if (IsEmpty)
        {
            <div class="platform-empty-state meter-empty" style="min-height: 340px;">
                <span class="platform-empty-icon">
                    <MudIcon Icon="@Icons.Material.Filled.FormatListBulleted" Size="Size.Large"/>
                </span>
                <MudText Typo="Typo.h5">尚未建立计量点台账</MudText>
                <MudText Typo="Typo.body2" Class="meter-empty-text">
                    没有计量点，正式环境推上来的读数也没有归属——按用途、按系统的报表会一直是空的。
                    先建几块表试一下，或者等能源平台的台账清单确定后批量导入。
                </MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreate" Disabled="_dictionary is null">
                    新建第一个计量点
                </MudButton>
            </div>
        }
        else
        {
            <MudTable T="EnergyMeterDto" Items="_meters" Dense="true" Hover="true" Breakpoint="Breakpoint.Md"
                      Class="platform-data-table meter-table mt-3">
                <HeaderContent>
                    <MudTh>编码</MudTh>
                    <MudTh>名称</MudTh>
                    <MudTh>介质</MudTh>
                    <MudTh>组织</MudTh>
                    <MudTh>用途</MudTh>
                    <MudTh>系统</MudTh>
                    <MudTh>读数类型</MudTh>
                    <MudTh>倍率</MudTh>
                    <MudTh>状态</MudTh>
                    <MudTh Class="meter-col-right">操作</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="编码"><span class="meter-code">@context.Code</span></MudTd>
                    <MudTd DataLabel="名称">@context.Name</MudTd>
                    <MudTd DataLabel="介质">@($"{context.MediumName}（{context.Unit}）")</MudTd>
                    <MudTd DataLabel="组织">@context.OrgUnitName</MudTd>
                    <MudTd DataLabel="用途">@context.UsageTypeName</MudTd>
                    <MudTd DataLabel="系统">@context.SystemTypeName</MudTd>
                    <MudTd DataLabel="读数类型">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                 Color="@(context.IsCumulative ? Color.Secondary : Color.Info)">
                            @(context.IsCumulative ? "累计示数" : "区间用量")
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="倍率">@($"{context.Ratio:0.##}")</MudTd>
                    <MudTd DataLabel="状态">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                 Color="@StatusColor(context.IsEnabled)">
                            @(context.IsEnabled ? "启用" : "停用")
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="操作" Class="meter-col-right">
                        <MudStack Row="true" Spacing="1" Justify="Justify.FlexEnd">
                            <MudTooltip Text="编辑">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                               Color="Color.Secondary"
                                               OnClick="@(() => OpenEdit(context))"/>
                            </MudTooltip>
                            <MudTooltip Text="删除">
                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small"
                                               Color="Color.Error"
                                               OnClick="@(() => ConfirmDelete(context))"/>
                            </MudTooltip>
                        </MudStack>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudPaper>

    <MudGrid Spacing="3">
        <MudItem xs="12" lg="6">
            <MudPaper
                Class="platform-section-card platform-section-card--tinted platform-accent-secondary meter-config-card pa-4"
                Elevation="0">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween"
                          Wrap="Wrap.Wrap" Spacing="2">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <span class="platform-section-icon">
                            <MudIcon Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small"/>
                        </span>
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.h6" Class="platform-card-title">组织节点</MudText>
                            <MudText Typo="Typo.body2" Class="platform-card-description">
                                园区 → 部门 → 工序三级。工序不是组织单元，不要塞进部门表。
                            </MudText>
                        </MudStack>
                    </MudStack>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.Add" OnClick="OpenOrgCreateRoot">
                        新增部门
                    </MudButton>
                </MudStack>

                <div class="meter-org-list">
                    @foreach (EnergyOrgUnitDto unit in OrderedOrgUnits)
                    {
                        <div class="meter-org-row">
                            <span class="meter-org-indent" style="@IndentStyle(unit.Depth)"></span>
                            <span class="meter-org-name">@unit.Name</span>
                            <span class="meter-org-code">@unit.Code</span>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                     Color="@LevelColor(unit.Level)">
                                @LevelLabel(unit.Level)
                            </MudChip>
                            @if (unit.Level != "process")
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Secondary"
                                           OnClick="@(() => OpenOrgCreate(unit))">
                                    加下级
                                </MudButton>
                            }
                        </div>
                    }
                </div>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" lg="6">
            <MudPaper
                Class="platform-section-card platform-section-card--tinted platform-accent-secondary meter-config-card pa-4"
                Elevation="0">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <span class="platform-section-icon">
                        <MudIcon Icon="@Icons.Material.Filled.Scale" Size="Size.Small"/>
                    </span>
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h6" Class="platform-card-title">介质折标煤系数</MudText>
                        <MudText Typo="Typo.body2" Class="platform-card-description">
                            GB/T 2589 当量值。蒸汽按焓值取值，不同批次热值不同时留空由报表标注。
                        </MudText>
                    </MudStack>
                </MudStack>

                <div class="meter-factor-list">
                    @foreach (MediumFactorRow row in _factorRows)
                    {
                        <div class="meter-factor-row">
                            <span class="meter-factor-name">@row.Medium.Name</span>
                            <span class="meter-factor-unit">@($"kgce/{row.Medium.Unit}")</span>
                            @if (row.Medium.IsPrimaryEnergy)
                            {
                                <MudNumericField T="decimal?" @bind-Value="row.CoalFactor" Variant="Variant.Outlined"
                                                 Margin="Margin.Dense" HideSpinButtons="true"
                                                 Format="0.####" Class="meter-factor-input"/>
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Secondary"
                                           OnClick="@(() => SaveFactorAsync(row))">
                                    保存
                                </MudButton>
                            }
                            else
                            {
                                <span class="meter-factor-na">不计入综合能耗</span>
                            }
                        </div>
                    }
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudText Typo="Typo.caption" Class="meter-footnote mt-2">
        正式环境的读数由能源平台推送至 <code>POST /api/park-energy/readings</code>，按「计量点编码 + 抄见时刻」幂等写入；
        同一时刻重复推送会覆盖而不是累加。已有读数的计量点不允许删除，请改为停用。
    </MudText>
</MudStack>

<MudDialog @bind-Visible="_isEditorOpen" Options="PlatformDialogs.EditorSheet"
           AriaLabel="@(_editingId is null ? "新建计量点" : "编辑计量点")">
    <DialogContent>
        <MudStack Spacing="3" Class="platform-sheet">
            <section class="platform-sheet-section platform-accent-secondary">
                <MudText Typo="Typo.h6">@(_editingId is null ? "新建计量点" : "编辑计量点")</MudText>
                <MudTextField T="string" Label="计量点编码" @bind-Value="_editorCode" Immediate="true"
                              HelperText="全园区唯一，与外部能源平台推送时使用的编码一致"/>
                <MudTextField T="string" Label="名称" @bind-Value="_editorName" Immediate="true"/>
            </section>

            <section class="platform-sheet-section platform-accent-secondary">
                <MudText Typo="Typo.subtitle2">分类标签</MudText>
                <MudSelect T="Guid?" Label="介质" @bind-Value="_editorMediumId" Variant="Variant.Outlined"
                           Dense="true" HelperText="决定单位与折标煤系数">
                    @foreach (EnergyMediumDto item in _dictionary?.Media ?? [])
                    {
                        <MudSelectItem T="Guid?" Value="@item.Id">@MediumLabel(item)</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="Guid?" Label="组织" @bind-Value="_editorOrgUnitId" Variant="Variant.Outlined"
                           Dense="true" HelperText="园区 → 部门 → 工序，选能覆盖到的最细层级">
                    @foreach (EnergyOrgUnitDto unit in _dictionary?.OrgUnits ?? [])
                    {
                        <MudSelectItem T="Guid?" Value="@unit.Id">@OrgLabel(unit)</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="Guid?" Label="用能用途" @bind-Value="_editorUsageTypeId" Variant="Variant.Outlined"
                           Dense="true" HelperText="回答「这笔能源为谁服务」，跟随所在区域">
                    @foreach (EnergyDictionaryItemDto item in _dictionary?.UsageTypes ?? [])
                    {
                        <MudSelectItem T="Guid?" Value="@item.Id">@item.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="Guid?" Label="设备系统" @bind-Value="_editorSystemTypeId" Variant="Variant.Outlined"
                           Dense="true" HelperText="回答「什么设备在用」，照明归这里不归用途">
                    @foreach (EnergyDictionaryItemDto item in _dictionary?.Systems ?? [])
                    {
                        <MudSelectItem T="Guid?" Value="@item.Id">@item.Name</MudSelectItem>
                    }
                </MudSelect>
            </section>

            <section class="platform-sheet-section platform-accent-secondary">
                <MudText Typo="Typo.subtitle2">取数方式</MudText>
                <MudSwitch T="bool" @bind-Value="_editorCumulative" Color="Color.Secondary"
                           Label="读数为累计示数（电表类）；关闭表示读数本身即区间用量（流量计类）"/>
                <MudNumericField T="decimal" Label="倍率" @bind-Value="_editorRatio" Variant="Variant.Outlined"
                                 Margin="Margin.Dense" Min="0.01m" HelperText="读数乘倍率才是实际用量"/>
                <MudSelect T="Guid?" Label="上级计量点" @bind-Value="_editorParentId" Variant="Variant.Outlined"
                           Dense="true" Clearable="true"
                           HelperText="用于总分表平衡校验，差额会单列为损耗">
                    @foreach (EnergyMeterDto meter in _meters.Where(item => item.Id != _editingId))
                    {
                        <MudSelectItem T="Guid?" Value="@meter.Id">@($"{meter.Code} · {meter.Name}")</MudSelectItem>
                    }
                </MudSelect>
                <MudTextField T="string" Label="备注" @bind-Value="_editorRemark" Immediate="true"
                              Lines="2"/>
                <MudSwitch T="bool" @bind-Value="_editorEnabled" Color="Color.Secondary" Label="启用"/>
            </section>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="@(() => _isEditorOpen = false)">取消</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="SaveAsync" Disabled="_isSaving">
            保存
        </MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_isOrgEditorOpen" Options="PlatformDialogs.EditorSheet" AriaLabel="新增组织节点">
    <DialogContent>
        <MudStack Spacing="3" Class="platform-sheet">
            <section class="platform-sheet-section platform-accent-secondary">
                <MudText Typo="Typo.h6">新增组织节点</MudText>
                <MudTextField T="string" Label="节点编码" @bind-Value="_orgCode" Immediate="true"
                              HelperText="全园区唯一，建议用 DEPT-xxx / PROC-xxx"/>
                <MudTextField T="string" Label="名称" @bind-Value="_orgName" Immediate="true"/>
                <MudTextField T="string" Label="上级" Value="@_orgParentLabel" ReadOnly="true"/>
                <MudTextField T="string" Label="层级" Value="@LevelLabel(_orgLevel)" ReadOnly="true"/>
            </section>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="@(() => _isOrgEditorOpen = false)">取消</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="SaveOrgUnitAsync"
                   Disabled="_isSaving">
            保存
        </MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_isConfirmOpen" Options="PlatformDialogs.Confirm" AriaLabel="删除计量点">
    <DialogContent>
        <MudStack Spacing="2">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudAvatar Size="Size.Medium" Class="platform-dialog-icon-warning">
                    <MudIcon Icon="@Icons.Material.Filled.HelpOutline" Size="Size.Small"/>
                </MudAvatar>
                <MudText Typo="Typo.h6">删除计量点</MudText>
            </MudStack>
            <MudText Typo="Typo.body2">
                确认删除「@_pendingDelete?.Name」？已有读数的计量点会被服务端拒绝，需要改为停用。
            </MudText>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="@(() => _isConfirmOpen = false)">取消</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="DeleteAsync">删除</MudButton>
    </DialogActions>
</MudDialog>
