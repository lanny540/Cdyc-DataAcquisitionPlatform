@page "/not-found"
@layout MainLayout

<PageTitle>页面不存在</PageTitle>

<div class="status-code-shell">
    <MudPaper Class="status-code-card not-found-card" Elevation="0">
        <MudStack AlignItems="AlignItems.Center" Spacing="2">
            <MudAvatar Size="Size.Large" Class="not-found-avatar">
                <MudIcon Icon="@Icons.Material.Filled.SearchOff" Color="Color.Warning" Size="Size.Large"/>
            </MudAvatar>
            <MudText Typo="Typo.h4">页面不存在</MudText>
            <MudText Typo="Typo.body1" Align="Align.Center" Color="Color.Secondary">
                你访问的内容不存在，或者已经被移动到其他位置。
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/" StartIcon="@Icons.Material.Filled.Home">
                返回首页
            </MudButton>
        </MudStack>
    </MudPaper>
</div>
