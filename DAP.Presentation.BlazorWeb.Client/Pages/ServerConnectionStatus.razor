@page "/server-connection-status"

<PageTitle>服务器连接状态</PageTitle>

<MudStack Class="platform-page-shell server-status-shell" Spacing="3">
    <MudPaper Class="platform-page-hero server-status-hero pa-6" Elevation="0">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Spacing="3">
            <MudStack Spacing="1">
                <MudText Typo="Typo.h4">服务器连接状态</MudText>
                <MudText Typo="Typo.body1" Class="server-status-hero-description">
                    集中查看当前配置的外部服务器是否可达。开发环境即使无法连通生产地址，也能明确看到地址、凭据配置和当前探测结果，
                    方便管理员在保存采集节点前先确认环境状态。
                </MudText>
            </MudStack>

            <MudButton Variant="Variant.Outlined" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="LoadAsync">
                刷新状态
            </MudButton>
        </MudStack>
    </MudPaper>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <MudAlert Severity="@_messageSeverity" Dense="true" Variant="Variant.Outlined">@_message</MudAlert>
    }

    <MudGrid>
        @if (_statuses.Count == 0 && !_isLoading)
        {
            <MudItem xs="12">
                <MudPaper Class="platform-panel server-status-empty pa-8" Elevation="0">
                    <MudStack AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.Router" Size="Size.Large" Color="Color.Default"/>
                        <MudText Typo="Typo.h6">当前还没有可显示的服务器状态</MudText>
                    </MudStack>
                </MudPaper>
            </MudItem>
        }
        else
        {
            @foreach (var item in _statuses)
            {
                <MudItem xs="12" lg="6">
                    <MudPaper Class="platform-panel server-status-card pa-5" Elevation="0">
                        <MudStack Spacing="3">
                            <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.SpaceBetween"
                                      Wrap="Wrap.Wrap">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.h6" Class="platform-card-title">@item.DisplayName</MudText>
                                    <MudText Typo="Typo.body2"
                                             Class="platform-card-description server-status-address">@item.Address</MudText>
                                </MudStack>
                                <MudChip T="string" Variant="Variant.Outlined" Color="@GetStatusColor(item)">
                                    @GetStatusText(item)
                                </MudChip>
                            </MudStack>

                            <MudGrid>
                                <MudItem xs="12" md="4">
                                    <MudPaper Class="platform-stat-card server-status-metric pa-4" Elevation="0">
                                        <MudText Typo="Typo.caption">服务器地址</MudText>
                                        <MudText
                                            Typo="Typo.body1">@(!string.IsNullOrWhiteSpace(item.Address) ? "已配置" : "未配置")</MudText>
                                    </MudPaper>
                                </MudItem>
                                <MudItem xs="12" md="4">
                                    <MudPaper Class="platform-stat-card server-status-metric pa-4" Elevation="0">
                                        <MudText Typo="Typo.caption">凭据配置</MudText>
                                        <MudText
                                            Typo="Typo.body1">@(item.CredentialsConfigured ? "已配置" : "未配置")</MudText>
                                    </MudPaper>
                                </MudItem>
                                <MudItem xs="12" md="4">
                                    <MudPaper Class="platform-stat-card server-status-metric pa-4" Elevation="0">
                                        <MudText Typo="Typo.caption">业务执行模式</MudText>
                                        <MudText
                                            Typo="Typo.body1">@(item.UseMockResponses ? "Mock" : "真实请求")</MudText>
                                    </MudPaper>
                                </MudItem>
                            </MudGrid>

                            <MudPaper Class="server-status-summary pa-3" Elevation="0">
                                <MudText Typo="Typo.caption" Class="server-status-summary-label">状态说明</MudText>
                                <MudText Typo="Typo.body2">@item.StatusMessage</MudText>
                            </MudPaper>

                            @if (!string.IsNullOrWhiteSpace(item.ErrorMessage))
                            {
                                <MudAlert Severity="Severity.Warning" Dense="true" Variant="Variant.Outlined">
                                    @item.ErrorMessage
                                </MudAlert>
                            }

                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                最后检查时间：@item.CheckedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                            </MudText>
                        </MudStack>
                    </MudPaper>
                </MudItem>
            }
        }
    </MudGrid>
</MudStack>
