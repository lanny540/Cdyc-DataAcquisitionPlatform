@page "/change-password"
@layout AuthLayout

<PageTitle>修改密码 · CDYC 数据采集平台</PageTitle>

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="platform-auth-error" role="alert">
        <span>@ErrorMessage</span>
    </div>
}

@* 页内小标题用独立类：.platform-auth-title 是外壳里的品牌名，
   两处同名会让人误以为是同一层级，选择器也会互相干扰。 *@
<div class="platform-auth-section">
    <div class="platform-auth-section-title">修改密码</div>
    <div class="platform-auth-hint">
        首次登录必须修改初始密码才能进入业务页面。新密码至少 8 位，且需同时包含字母与数字。
    </div>
</div>

<form method="post" action="/api/auth/change-password" class="platform-auth-form">
    <div class="platform-auth-field">
        <label class="platform-auth-label" for="currentPassword">当前密码</label>
        <input class="platform-auth-input" id="currentPassword" name="currentPassword" type="password"
               autocomplete="current-password" required placeholder="请输入当前密码"/>
    </div>
    <div class="platform-auth-field">
        <label class="platform-auth-label" for="newPassword">新密码</label>
        <input class="platform-auth-input" id="newPassword" name="newPassword" type="password"
               autocomplete="new-password" required placeholder="至少 8 位，含字母与数字"/>
    </div>
    <div class="platform-auth-field">
        <label class="platform-auth-label" for="confirmPassword">确认新密码</label>
        <input class="platform-auth-input" id="confirmPassword" name="confirmPassword" type="password"
               autocomplete="new-password" required placeholder="再次输入新密码"/>
    </div>
    <button type="submit" class="platform-auth-submit">保存并进入平台</button>
</form>

<div class="platform-auth-meta">
    修改成功后会用新信息重新签发会话，无需再次登录。
</div>

@code {
    /// <summary>
    /// 改密失败原因。由端点通过查询串回传。
    /// </summary>
    [SupplyParameterFromQuery(Name = "error")]
    public string? ErrorMessage { get; set; }
}
