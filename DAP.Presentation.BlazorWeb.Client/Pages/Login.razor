@page "/login"
@layout AuthLayout
@using DAP.Core.Shared.Contracts
@using DAP.Presentation.BlazorWeb.Client.Services
@inject IPlatformApiClient Api

<PageTitle>登录 · CDYC 数据采集平台</PageTitle>

@* 表单用原生提交（method/action），不挂 @onsubmit：
   InteractiveAuto 下页面可能落在 Server 电路里，电路内拿不到 HttpContext，签不出 Cookie。
   原生提交由浏览器直接请求端点，服务端完成签发后 302 到落地页，两种渲染模式行为一致。 *@
@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="platform-auth-error" role="alert">
        <span>@ErrorMessage</span>
    </div>
}

<form method="post" action="/api/auth/login" class="platform-auth-form">
    <input type="hidden" name="returnUrl" value="@ReturnUrl"/>
    <div class="platform-auth-field">
        <label class="platform-auth-label" for="userName">账号</label>
        <input class="platform-auth-input" id="userName" name="userName" type="text"
               autocomplete="username" required autofocus value="@UserName"
               placeholder="请输入账号"/>
    </div>
    <div class="platform-auth-field">
        <label class="platform-auth-label" for="password">密码</label>
        <input class="platform-auth-input" id="password" name="password" type="password"
               autocomplete="current-password" required placeholder="请输入密码"/>
    </div>
    <button type="submit" class="platform-auth-submit">登录</button>
</form>

@* 外部身份源入口：只渲染已配置的提供方，未配置时整段不出现（不留空按钮）。 *@
@if (Providers.Count > 0)
{
    <div class="platform-auth-divider"><span>或使用统一登录</span></div>
    <div class="platform-auth-external">
        @foreach (OidcProviderDto provider in Providers)
        {
            <a class="platform-auth-external-link" href="@BuildProviderHref(provider)">@provider.DisplayName</a>
        }
    </div>
}

<div class="platform-auth-meta">
    账号由管理员分配。连续输错 5 次将锁定 15 分钟；首次登录需要修改初始密码。
</div>

@code {
    /// <summary>
    /// 可用的外部登录方式。
    /// </summary>
    private IReadOnlyList<OidcProviderDto> Providers { get; set; } = [];

    /// <summary>
    /// 登录失败原因。由端点通过查询串回传，直接展示，不再拼接框架异常信息。
    /// </summary>
    [SupplyParameterFromQuery(Name = "error")]
    public string? ErrorMessage { get; set; }

    /// <summary>
    /// 回填的账号，避免用户重新输入。
    /// </summary>
    [SupplyParameterFromQuery(Name = "userName")]
    public string? UserName { get; set; }

    /// <summary>
    /// 登录成功后要回到的原始地址。
    /// </summary>
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        try
        {
            Providers = await Api.GetOidcProvidersAsync();
        }
        catch (Exception)
        {
            // 外部登录是附加能力：取不到就只留账号密码，不能因此让登录页报错。
            Providers = [];
        }
    }

    private string BuildProviderHref(OidcProviderDto provider)
    {
        return string.IsNullOrWhiteSpace(ReturnUrl)
            ? provider.Href
            : $"{provider.Href}?returnUrl={Uri.EscapeDataString(ReturnUrl)}";
    }
}
