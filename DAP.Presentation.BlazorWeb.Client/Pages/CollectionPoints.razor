@page "/collection-points"

<PageTitle>采集点管理</PageTitle>

<MudStack Class="platform-page-shell tw-gap-4" Spacing="2">
    <MudPaper Class="platform-page-hero tw-p-4" Elevation="0">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Spacing="3">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h4" GutterBottom="true">采集点配置管理</MudText>
                <MudText Typo="Typo.body1" Class="collection-points-hero-description">
                    管理采集端点、通信协议与启用状态。
                </MudText>
                <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" Class="mt-2">
                    <MudChip T="string" Variant="Variant.Outlined"
                             Color="Color.Info">@($"{_collectionPoints.Count} 个采集点")</MudChip>
                    <MudChip T="string" Variant="Variant.Outlined"
                             Color="Color.Success">@($"{EnabledCollectionPointCount} 个已启用")</MudChip>
                    <MudChip T="string" Variant="Variant.Outlined"
                             Color="Color.Primary">@($"{OnlineCollectionPointCount} 个在线")</MudChip>
                </MudStack>
            </MudStack>
            <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                <MudButton Variant="Variant.Outlined" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="LoadAsync">
                    刷新列表
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenCreateDrawer">
                    新增采集点
                </MudButton>
            </MudStack>
        </MudStack>
    </MudPaper>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <MudAlert Severity="@_messageSeverity" Dense="true" Variant="Variant.Outlined">@_message</MudAlert>
    }

    <ConfirmDialog IsOpen="_pendingDeletePoint is not null"
                   Title="确认删除采集点"
                   DialogSeverity="Severity.Error"
                   WarningText="该操作不可撤销，请再次确认。"
                   ConfirmButtonText="确认删除"
                   BusyButtonText="删除中..."
                   ConfirmButtonColor="Color.Error"
                   IsBusy="_isDeleting"
                   CloseOnBackdropClick="true"
                   OnCancel="CancelDelete"
                   OnConfirm="ConfirmDeleteAsync">
        @if (_pendingDeletePoint is not null)
        {
            <MudText Typo="Typo.body1">
                即将删除采集点 <b>@_pendingDeletePoint.Code</b>（@_pendingDeletePoint.Name），删除后将同时移除其关联采集数据记录。
            </MudText>
        }
    </ConfirmDialog>

    <MudPaper Class="platform-section-card collection-points-table-card" Elevation="0">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Spacing="2"
                  Class="pa-4">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6" Class="platform-card-title">服务端采集点列表</MudText>
                <MudText Typo="Typo.body2" Class="platform-card-description">
                    查看通信状态，或打开右侧表单修改配置。
                </MudText>
            </MudStack>
            <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                <MudChip T="string" Variant="Variant.Text" Color="Color.Default">来源可区分 Server / Local</MudChip>
                <MudChip T="string" Variant="Variant.Text" Color="Color.Default">点击编辑在右侧打开表单</MudChip>
            </MudStack>
        </MudStack>

        <MudDivider/>

        <MudTable Items="_collectionPoints"
                  Dense="true"
                  Hover="true"
                  Loading="_isLoading"
                  RowsPerPage="10"
                  Breakpoint="Breakpoint.Sm"
                  Class="platform-data-table collection-points-table">
            <HeaderContent>
                <MudTh>编码</MudTh>
                <MudTh>名称</MudTh>
                <MudTh>协议</MudTh>
                <MudTh>通信状态</MudTh>
                <MudTh>来源</MudTh>
                <MudTh>更新时间</MudTh>
                <MudTh Style="width: 220px;">操作</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="编码">
                    <MudText Typo="Typo.body1" Class="platform-table-primary platform-inline-code">
                        @context.Code
                    </MudText>
                </MudTd>
                <MudTd DataLabel="名称">
                    <MudText Typo="Typo.body2" Class="platform-table-primary">@context.Name</MudText>
                </MudTd>
                <MudTd DataLabel="协议">
                    <MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small">
                        @context.Protocol
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="通信状态">
                    <MudChip T="string" Color="@(context.CommunicationStatus == "在线" ? Color.Success : Color.Error)"
                             Variant="Variant.Outlined" Size="Size.Small">
                        @context.CommunicationStatus
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="来源">
                    <MudChip T="string" Color="@(context.Source == "Local" ? Color.Warning : Color.Info)"
                             Variant="Variant.Text" Size="Size.Small">
                        @context.Source
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="更新时间">
                    <MudText Typo="Typo.body2" Class="platform-timestamp">
                        @context.UpdatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                    </MudText>
                </MudTd>
                <MudTd DataLabel="操作" Class="table-action-cell">
                    <div class="table-action-grid table-action-grid--two">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   Class="table-action-button"
                                   FullWidth="true"
                                   StartIcon="@Icons.Material.Filled.Edit"
                                   OnClick="@(() => EditAsync(context))">
                            编辑
                        </MudButton>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Error"
                                   Class="table-action-button"
                                   FullWidth="true"
                                   StartIcon="@Icons.Material.Filled.DeleteOutline"
                                   OnClick="@(() => RequestDelete(context))">
                            删除
                        </MudButton>
                    </div>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudStack AlignItems="AlignItems.Center" Class="pa-10">
                    <MudIcon Icon="@Icons.Material.Filled.SettingsInputComponent" Size="Size.Large"
                             Color="Color.Default"/>
                    <MudText Typo="Typo.h6" Class="mt-3">当前还没有采集点</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        可以从右上角新增采集点，或等待客户端同步后刷新查看。
                    </MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" OnClick="OpenCreateDrawer">
                        立即新增
                    </MudButton>
                </MudStack>
            </NoRecordsContent>
            <PagerContent><MudTablePager PageSizeOptions="@(new[] { 10, 20, 50 })" RowsPerPageString="每页条数"/></PagerContent>
        </MudTable>
    </MudPaper>

    <MudOverlay Visible="_isEditorOpen"
                DarkBackground="true"
                LockScroll="true"
                ZIndex="1400"
                Class="platform-sheet-overlay"
                OnClick="@(_ => CloseEditor())">
        <div class="platform-sheet" role="dialog" aria-modal="true" aria-label="@EditorTitle" @onclick:stopPropagation="true" @key="_editorRenderKey">
                <MudStack Class="platform-sheet-header" Row="true" AlignItems="AlignItems.Start"
                          Justify="Justify.SpaceBetween" Spacing="2">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h5">@EditorTitle</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
                            @EditorDescription
                        </MudText>
                    </MudStack>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Default" OnClick="CloseEditor" aria-label="关闭编辑"/>
                </MudStack>

                <MudStack Class="platform-sheet-body" Spacing="2">
                    <MudAlert Severity="@(_editingId.HasValue ? Severity.Info : Severity.Success)" Dense="true"
                              Variant="Variant.Outlined">
                        @(_editingId.HasValue ? "当前正在编辑已有采集点，保存后会直接更新服务端配置。" : "正在创建新的服务端采集点，保存后会立即出现在列表中。")
                    </MudAlert>

                    <MudTextField Margin="Margin.Dense" Label="采集点编码"
                                  @bind-Value="_code"
                                  Variant="Variant.Outlined"
                                  Immediate="true"
                                  Placeholder="例如 CP-001"/>
                    <MudTextField Margin="Margin.Dense" Label="采集点名称"
                                  @bind-Value="_name"
                                  Variant="Variant.Outlined"
                                  Immediate="true"
                                  Placeholder="输入便于识别的点位名称"/>
                    <MudTextField Margin="Margin.Dense" Label="采集协议"
                                  @bind-Value="_protocol"
                                  Variant="Variant.Outlined"
                                  Immediate="true"
                                  Placeholder="例如 Modbus TCP"/>
                    <MudTextField Margin="Margin.Dense" Label="采集端点"
                                  @bind-Value="_endpoint"
                                  Variant="Variant.Outlined"
                                  Immediate="true"
                                  Lines="3"
                                  Placeholder="例如 192.168.1.10:502"/>
                    <MudSwitch T="bool" @bind-Value="_isEnabled" Color="Color.Primary">启用采集点</MudSwitch>
                </MudStack>

                <MudStack Class="platform-sheet-footer" Row="true" Spacing="2" Justify="Justify.FlexEnd" Wrap="Wrap.Wrap">
                    <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="CancelEditor">
                        取消
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="ResetEditor">
                        清空
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">
                        @SaveButtonText
                    </MudButton>
                </MudStack>
        </div>
    </MudOverlay>
</MudStack>
