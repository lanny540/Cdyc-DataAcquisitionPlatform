@using System.Security.Claims
@using DAP.Core.Shared.Catalog
@using DAP.Core.Shared.Contracts
@using DAP.Presentation.BlazorWeb.Client.Services
@using Microsoft.AspNetCore.Components.Authorization
@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav
@inject INavigationViewClient NavigationView

<MudThemeProvider Theme="_theme"/>
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>
<MudLayout Class="platform-layout">
    <MudAppBar Elevation="0" Class="platform-appbar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       Class="platform-menu-toggle" aria-label="切换导航菜单"
                       OnClick="@((_) => DrawerToggle())"/>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="platform-brand">
            <MudAvatar Size="Size.Medium" Rounded="true" Class="platform-brand-avatar">
                <MudIcon Icon="@Icons.Material.Filled.Stream" Size="Size.Medium"/>
            </MudAvatar>
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6" Class="platform-brand-title">CDYC 数据采集平台</MudText>
                <MudText Typo="Typo.caption" Class="platform-brand-subtitle">统一采集配置、连接诊断与运行观测</MudText>
            </MudStack>
        </MudStack>
        @* 顶栏渲染「用户可见域列表」，不是固定模块：域可见性、空域规则全部由服务端判定。
           域数量可变，新增域不需要改这里（docs/AUTH_DESIGN.md 13.1）。 *@
        <nav class="platform-topnav" aria-label="职能域导航">
            @if (_navigation is null)
            {
                <span class="platform-topnav-loading">导航加载中…</span>
            }
            else
            {
                @foreach (NavigationDomainDto domain in _navigation.Domains)
                {
                    var target = domain;
                    <button type="button"
                            class="@TopNavClass(target)"
                            aria-current="@(IsActiveDomain(target) ? "page" : null)"
                            @onclick="@(() => SelectDomain(target))">
                        <MudIcon Icon="@NavigationCatalog.DomainIcon(target.Code)" Size="Size.Small"/>
                        <span>@target.Name</span>
                        @if (target.IsEmpty)
                        {
                            <span class="platform-topnav-badge">未上线</span>
                        }
                    </button>
                }
            }
        </nav>
        <MudChip T="string" Color="Color.Success" Variant="Variant.Outlined" Class="platform-version-chip">
            Web 管理端 @AppVersion
        </MudChip>
        @* 账号区只读当前会话里的 claims，不额外请求 /api/auth/me：
           会话失效时由路由守卫与服务端闸门拦到登录页，这里不做第二套判定。
           车间只读终端没有账号概念：显示「只读」标识，不提供登出。 *@
        <AuthorizeView>
            <Authorized>
                <div class="platform-user-area">
                    @if (IsBoardTerminal(context.User))
                    {
                        <span class="platform-board-chip">
                            <MudIcon Icon="@Icons.Material.Filled.Monitor" Size="Size.Small"/>
                            车间终端 · 只读
                        </span>
                    }
                    else
                    {
                        <span class="platform-user-avatar">
                            <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small"/>
                        </span>
                        <span class="platform-user-name">@ResolveDisplayName(context.User)</span>
                        @* 原生表单提交而非 @onsubmit：InteractiveAuto 下页面可能落在 Server 电路里，
                           电路内拿不到 HttpContext，签不掉 Cookie。浏览器直接 POST 由端点完成登出。 *@
                        <form method="post" action="/api/auth/logout" class="platform-logout-form">
                            <button type="submit" class="platform-logout-button" aria-label="退出登录" title="退出登录">
                                <MudIcon Icon="@Icons.Material.Filled.Logout" Size="Size.Small"/>
                            </button>
                        </form>
                    }
                </div>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen"
               ClipMode="DrawerClipMode.Always"
               Elevation="0"
               Width="232px"
               Variant="DrawerVariant.Responsive"
               Breakpoint="Breakpoint.Md"
               Class="platform-drawer">
        <MudDrawerHeader Class="platform-drawer-header">
            <MudStack Spacing="0" Class="platform-drawer-heading">
                <MudText Typo="Typo.subtitle2" Class="platform-drawer-title">@ActiveDomain?.Name</MudText>
                <MudText Typo="Typo.caption" Class="platform-drawer-subtitle">@DrawerSubtitle</MudText>
            </MudStack>
        </MudDrawerHeader>
        @if (ActiveDomain is not null)
        {
            <NavMenu Domain="@ActiveDomain"/>
        }
    </MudDrawer>
    <MudMainContent Class="platform-main-content">
        <MudContainer MaxWidth="MaxWidth.False" Class="platform-page-container">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    页面发生异常，请重新加载。
    <a href="." class="reload">重新加载</a>
    <button type="button" class="dismiss" aria-label="关闭错误提示">关闭</button>
</div>

@code {
    private bool _drawerOpen = true;

    /// <summary>
    /// 当前用户的导航树。null 表示加载中或未认证——未认证会被路由守卫拦走，不会停留在本布局。
    /// </summary>
    private NavigationDto? _navigation;

    /// <summary>
    /// 当前顶栏选中的职能域编码。左侧菜单只渲染该域的分组与子菜单。
    /// </summary>
    private string _activeDomainCode = string.Empty;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private NavigationDomainDto? ActiveDomain => _navigation?.Domains
        .FirstOrDefault(domain => string.Equals(domain.Code, _activeDomainCode, StringComparison.Ordinal));

    /// <summary>
    /// 抽屉副标题：空域显式说明「未上线」，正常域给出页面计数。
    /// </summary>
    private string DrawerSubtitle => ActiveDomain is null
        ? string.Empty
        : ActiveDomain.IsEmpty
            ? "该板块尚未上线"
            : $"共 {ActiveDomain.Groups.Sum(group => group.Pages.Count)} 个功能页面";

    private string CurrentPath => Nav.ToBaseRelativePath(Nav.Uri);

    protected override async Task OnInitializedAsync()
    {
        // 导航按当前会话过滤。服务端直调构建服务；WASM 调 /api/navigation（Cookie 判定）。
        ClaimsPrincipal? principal = null;

        if (AuthenticationStateTask is not null)
        {
            AuthenticationState state = await AuthenticationStateTask;
            principal = state.User;
        }

        try
        {
            _navigation = await NavigationView.LoadAsync(principal);
        }
        catch (Exception)
        {
            // 加载失败渲染空导航：认证闸门与路由守卫会兜底，不让用户停在无壳页面。
            _navigation = null;
        }

        // 刷新页面或直接输入地址时，按路由反推所属域，避免顶栏高亮与内容错位。
        _activeDomainCode = ResolveDomain(CurrentPath)?.Code
                            ?? _navigation?.Domains.FirstOrDefault()?.Code
                            ?? string.Empty;

        Nav.LocationChanged += OnLocationChanged;
    }

    /// <summary>
    /// 顶栏一级导航的样式类。激活态由 platform-topnav-item--active 表达，不在此处写色值。
    /// </summary>
    private string TopNavClass(NavigationDomainDto domain)
    {
        return IsActiveDomain(domain)
            ? "platform-topnav-item platform-topnav-item--active"
            : "platform-topnav-item";
    }

    private bool IsActiveDomain(NavigationDomainDto domain)
    {
        return string.Equals(domain.Code, _activeDomainCode, StringComparison.Ordinal);
    }

    /// <summary>
    /// 路由变化时同步顶栏高亮：左侧菜单点击、浏览器前进后退都会走到这里。
    /// </summary>
    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        var domain = ResolveDomain(Nav.ToBaseRelativePath(args.Location));

        if (domain is null || string.Equals(domain.Code, _activeDomainCode, StringComparison.Ordinal))
        {
            return;
        }

        _activeDomainCode = domain.Code;
        _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// 点击顶栏域，三种情形（docs/AUTH_DESIGN.md 12.3）：
    /// 当前页面属于该域 → 只切换左侧菜单；不属于 → 跳该域首个页面；
    /// 空域（仅超管可见）→ 不跳转，左侧渲染空状态，保住从顶栏回到配置页的路径。
    /// </summary>
    private void SelectDomain(NavigationDomainDto domain)
    {
        var domainChanged = !string.Equals(domain.Code, _activeDomainCode, StringComparison.Ordinal);
        _activeDomainCode = domain.Code;

        if (!_drawerOpen)
        {
            _drawerOpen = true;
        }

        if (domain.IsEmpty || domain.FirstPage is null)
        {
            return;
        }

        if (domainChanged && !DomainContains(domain, CurrentPath))
        {
            Nav.NavigateTo(domain.FirstPage.Route);
        }
    }

    /// <summary>
    /// 按当前路由反查所属域，用于刷新页面或直接输入地址时同步顶栏高亮。
    /// 采用最长前缀匹配：/managed-data-definitions/{id} 归「点位数据管理」而不是更短的条目。
    /// </summary>
    private NavigationDomainDto? ResolveDomain(string? relativePath)
    {
        if (_navigation is null)
        {
            return null;
        }

        var path = Normalize(relativePath);

        NavigationDomainDto? matched = null;
        var matchedLength = -1;

        foreach (NavigationDomainDto domain in _navigation.Domains)
        {
            foreach (NavigationPageDto page in domain.Groups.SelectMany(group => group.Pages))
            {
                var href = Normalize(page.Route);

                var isMatch = href.Length == 0
                    ? path.Length == 0
                    : path.Equals(href, StringComparison.OrdinalIgnoreCase)
                      || path.StartsWith(href + "/", StringComparison.OrdinalIgnoreCase);

                if (!isMatch || href.Length <= matchedLength)
                {
                    continue;
                }

                matched = domain;
                matchedLength = href.Length;
            }
        }

        return matched;
    }

    private bool DomainContains(NavigationDomainDto domain, string? relativePath)
    {
        return string.Equals(ResolveDomain(relativePath)?.Code, domain.Code, StringComparison.Ordinal);
    }

    /// <summary>
    /// 归一化地址：去掉首尾斜杠与查询串，便于统一比较。
    /// </summary>
    private static string Normalize(string? path)
    {
        if (string.IsNullOrWhiteSpace(path))
        {
            return string.Empty;
        }

        var trimmed = path.Trim();

        var queryIndex = trimmed.IndexOfAny(['?', '#']);
        if (queryIndex >= 0)
        {
            trimmed = trimmed[..queryIndex];
        }

        return trimmed.Trim('/');
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }

    /// <summary>
    /// 平台统一色板（Material Design 3）。定义见 <see cref="PlatformTheme"/>，
    /// 登录页与主框架共用同一份，避免未登录时看到另一套配色。
    /// </summary>
    private readonly MudTheme _theme = PlatformTheme.Create();

    private string AppVersion => $"v{System.Reflection.Assembly.GetExecutingAssembly().GetName().Version?.ToString(3) ?? "1.0.0"}";

    /// <summary>
    /// 顶栏展示的姓名：优先 display_name，缺失时退回账号名。
    /// </summary>
    private static string ResolveDisplayName(ClaimsPrincipal user)
    {
        var displayName = user.FindFirst(AuthorizationCatalog.PlatformClaimTypes.DisplayName)?.Value;

        return string.IsNullOrWhiteSpace(displayName)
            ? user.Identity?.Name ?? "未命名账号"
            : displayName;
    }

    /// <summary>
    /// 是否车间只读终端会话（IP 白名单签发）。
    /// </summary>
    private static bool IsBoardTerminal(ClaimsPrincipal user)
    {
        return user.HasClaim(AuthorizationCatalog.PlatformClaimTypes.BoardTerminal, "true");
    }

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

}
