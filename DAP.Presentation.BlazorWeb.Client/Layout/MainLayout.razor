@inherits LayoutComponentBase

<MudThemeProvider Theme="_theme"/>
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>
<MudLayout Class="platform-layout">
    <MudAppBar Elevation="0" Class="platform-appbar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       Class="platform-menu-toggle" aria-label="切换导航菜单"
                       OnClick="@((_) => DrawerToggle())"/>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="platform-brand">
            <MudAvatar Size="Size.Medium" Rounded="true" Class="platform-brand-avatar">
                <MudIcon Icon="@Icons.Material.Filled.Stream" Size="Size.Medium"/>
            </MudAvatar>
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6" Class="platform-brand-title">CDYC 数据采集平台</MudText>
                <MudText Typo="Typo.caption" Class="platform-brand-subtitle">统一采集配置、连接诊断与运行观测</MudText>
            </MudStack>
        </MudStack>
        <MudChip T="string" Color="Color.Success" Variant="Variant.Outlined" Class="platform-version-chip">
            Web 管理端 @AppVersion
        </MudChip>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen"
               ClipMode="DrawerClipMode.Always"
               Elevation="0"
               Width="232px"
               Variant="DrawerVariant.Responsive"
               Breakpoint="Breakpoint.Md"
               Class="platform-drawer">
        <MudDrawerHeader Class="platform-drawer-header">
            <MudText Typo="Typo.overline">工作空间</MudText>
        </MudDrawerHeader>
        <NavMenu/>
    </MudDrawer>
    <MudMainContent Class="platform-main-content">
        <MudContainer MaxWidth="MaxWidth.False" Class="platform-page-container">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    页面发生异常，请重新加载。
    <a href="." class="reload">重新加载</a>
    <button type="button" class="dismiss" aria-label="关闭错误提示">关闭</button>
</div>

@code {
    private bool _drawerOpen = true;

    /// <summary>
    /// 平台统一色板（Material Design 3）。
    /// 此处色值须与 app.css 的 --md-* 变量保持同步，改动规则见 docs/DESIGN_SYSTEM.md。
    /// </summary>
    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#0b4fc4",
            PrimaryContrastText = "#ffffff",
            Secondary = "#33475c",
            SecondaryContrastText = "#ffffff",
            Tertiary = "#7b2f9e",
            TertiaryContrastText = "#ffffff",
            Info = "#0f6fbd",
            InfoContrastText = "#ffffff",
            Success = "#0d7a3c",
            SuccessContrastText = "#ffffff",
            Warning = "#b15600",
            WarningContrastText = "#ffffff",
            Error = "#b32318",
            ErrorContrastText = "#ffffff",
            Background = "#f4f7fa",
            BackgroundGray = "#eef2f7",
            Surface = "#ffffff",
            AppbarBackground = "#ffffff",
            AppbarText = "#16202b",
            DrawerBackground = "#ffffff",
            DrawerIcon = "#4a5c70",
            DrawerText = "#16202b",
            TextPrimary = "#16202b",
            TextSecondary = "#4e5a70",
            TextDisabled = "#9aa6b6",
            ActionDefault = "#16202b",
            Divider = "#e1e7ee",
            DividerLight = "#eef2f7",
            LinesDefault = "#e1e7ee",
            LinesInputs = "#c7d0da",
            TableLines = "#e1e7ee",
            TableHover = "#dce8fa",
            TableStriped = "#f8fafc",
            Skeleton = "#e7ecf3"
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "4px",
            AppbarHeight = "56px",
            DrawerWidthLeft = "232px"
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = ["PingFang SC", "Microsoft YaHei", "sans-serif"],
                FontSize = "0.875rem",
                LineHeight = "1.5"
            },
            H3 = new H3Typography {FontSize = "2rem", FontWeight = "600", LineHeight = "1.25"},
            H4 = new H4Typography {FontSize = "1.375rem", FontWeight = "600", LineHeight = "1.4"},
            H5 = new H5Typography {FontSize = "1.125rem", FontWeight = "600", LineHeight = "1.4"},
            H6 = new H6Typography {FontSize = "1rem", FontWeight = "600", LineHeight = "1.5"},
            Body1 = new Body1Typography {FontSize = "0.875rem", LineHeight = "1.5"},
            Body2 = new Body2Typography {FontSize = "0.8125rem", LineHeight = "1.5"},
            Button = new ButtonTypography {FontSize = "0.8125rem", FontWeight = "500", TextTransform = "none"}
        }
    };

    private string AppVersion => $"v{System.Reflection.Assembly.GetExecutingAssembly().GetName().Version?.ToString(3) ?? "1.0.0"}";

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

}
