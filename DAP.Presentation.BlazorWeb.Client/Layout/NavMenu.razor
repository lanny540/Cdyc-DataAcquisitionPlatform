@using DAP.Presentation.BlazorWeb.Client.Layout

@* 左侧菜单只展示当前顶级模块的内容：分组标题 + 子菜单。
   菜单树全部来自 NavigationCatalog，顶栏与抽屉共用同一份数据源。 *@
<div class="platform-nav-shell">
    @if (Section.QuickLinks.Count > 0)
    {
        <MudNavMenu>
            @foreach (var item in Section.QuickLinks)
            {
                <NavMenuItem Item="@item"/>
            }
        </MudNavMenu>
    }

    @foreach (var group in Section.Groups)
    {
        <div class="platform-nav-section">@group.Title</div>
        <MudNavMenu>
            @foreach (var item in group.Items)
            {
                <NavMenuItem Item="@item"/>
            }
        </MudNavMenu>
    }
</div>

@code {
    /// <summary>
    /// 当前顶栏选中的顶级模块。
    /// </summary>
    [Parameter, EditorRequired]
    public NavSection Section { get; set; } = null!;
}
