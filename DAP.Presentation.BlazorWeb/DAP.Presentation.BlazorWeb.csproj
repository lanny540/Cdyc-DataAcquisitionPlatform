<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1"/>
    <ProjectReference Include="..\DAP.Presentation.BlazorWeb.Client\DAP.Presentation.BlazorWeb.Client.csproj"/>
    <ProjectReference Include="..\DAP.Core.Domain\DAP.Core.Domain.csproj"/>
    <ProjectReference Include="..\DAP.Core.Shared\DAP.Core.Shared.csproj"/>
    <ProjectReference Include="..\DAP.Infrastructure\DAP.Infrastructure.csproj"/>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.13"/>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13"/>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MudBlazor" Version="9.11.0"/>
  </ItemGroup>

  <Target Name="BuildTailwind" BeforeTargets="BeforeBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(MSBuildProjectDirectory)" Condition="!Exists('$(MSBuildProjectDirectory)/node_modules/tailwindcss/package.json')"/>
    <Exec Command="npm run build:css" WorkingDirectory="$(MSBuildProjectDirectory)"/>
  </Target>

</Project>
