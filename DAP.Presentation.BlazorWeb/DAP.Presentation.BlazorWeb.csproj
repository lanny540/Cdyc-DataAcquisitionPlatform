<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1"/>
    <ProjectReference Include="..\DAP.Presentation.BlazorWeb.Client\DAP.Presentation.BlazorWeb.Client.csproj"/>
    <ProjectReference Include="..\DAP.Core.Domain\DAP.Core.Domain.csproj"/>
    <ProjectReference Include="..\DAP.Core.Shared\DAP.Core.Shared.csproj"/>
    <ProjectReference Include="..\DAP.Infrastructure\DAP.Infrastructure.csproj"/>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.14"/>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.14"/>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14"/>
    <PackageReference Include="System.DirectoryServices.Protocols" Version="10.0.14"/>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MudBlazor" Version="9.14.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 安全服务中的审计守卫、当前用户上下文等为 internal，
         单元测试需要直接构造这些类型验证行为。 -->
    <InternalsVisibleTo Include="DAP.Tests.UnitTests"/>
  </ItemGroup>

</Project>
