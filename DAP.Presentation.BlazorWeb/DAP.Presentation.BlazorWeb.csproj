<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DAP.Presentation.BlazorWeb.Client\DAP.Presentation.BlazorWeb.Client.csproj"/>
    <ProjectReference Include="..\DAP.Core.Domain\DAP.Core.Domain.csproj"/>
    <ProjectReference Include="..\DAP.Core.Shared\DAP.Core.Shared.csproj"/>
    <ProjectReference Include="..\DAP.Infrastructure\DAP.Infrastructure.csproj"/>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MudBlazor" Version="9.10.0" />
  </ItemGroup>

</Project>
