<?xml version="1.0" encoding="utf-8"?>

<!--
  CDYC 数据采集平台 · 桌面端样式体系

  与 Web 端 app.css 的 platform 前缀类一一对应，语义相同、层次相同：
    页头 page-hero（tint 色块）、统计卡 stat-card（tint 色块 + 左侧 4px 色条，
    头条 KPI 用主色实底配反白文字）、区块卡 section-card（tint 色块 + 左侧 4px 色条）、
    白色底板 chart-frame / panel。圆角遵循 MD2 的 4dp。

  所有颜色都走 DapPalette.axaml 的资源键，禁止在本文件出现十六进制色值。
  具体色相由页面在控件上显式绑定 DapXxxTintBrush / DapXxxSoftBrush 决定，
  本文件只负责尺寸、圆角、字号与留白，避免为每个色相新增一条规则。

  外壳（顶栏、模块与抽屉选中）取主色紫 DapPrimary*，顶栏为主色实底
  （MD2 经典形态），表面文字用 DapOnPrimary* 反白资源。
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ============ 主按钮前景 ============
         实心主按钮为「主色实底白字」（MD2）。
         资源键层（SemiBrandOverride.axaml）已覆盖三态底色，
         这里再补一层控件级前景，保证主按钮始终是白字。 -->
  <Style Selector="Button.Primary">
    <Setter Property="Foreground" Value="{DynamicResource DapPrimaryOnBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.Primary:pointerover, Button.Primary:pressed">
    <Setter Property="Foreground" Value="{DynamicResource DapPrimaryOnBrush}" />
  </Style>

  <!-- ============ 文本层级 ============ -->
  <Style Selector="TextBlock.page-title">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource DapTextPrimaryBrush}" />
  </Style>

  <Style Selector="TextBlock.page-subtitle">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource DapTextSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.card-title">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource DapTextPrimaryBrush}" />
  </Style>

  <Style Selector="TextBlock.card-description">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource DapTextSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.stat-label">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource DapTextSecondaryBrush}" />
  </Style>

  <Style Selector="TextBlock.stat-value">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource DapTextPrimaryBrush}" />
  </Style>

  <Style Selector="TextBlock.stat-value-large">
    <Setter Property="FontSize" Value="32" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource DapTextPrimaryBrush}" />
  </Style>

  <Style Selector="TextBlock.stat-supporting">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource DapTextSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.field-label">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource DapTextSecondaryBrush}" />
  </Style>

  <Style Selector="TextBlock.timestamp">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource DapTextSubtleBrush}" />
  </Style>

  <Style Selector="TextBlock.table-primary">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource DapTextPrimaryBrush}" />
  </Style>

  <Style Selector="TextBlock.table-cell">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource DapTextPrimaryBrush}" />
  </Style>

  <Style Selector="TextBlock.empty-title">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource DapTextPrimaryBrush}" />
  </Style>

  <Style Selector="TextBlock.empty-text">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource DapTextSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="MaxWidth" Value="420" />
  </Style>

  <!-- ============ 容器 ============ -->
  <!-- 页面头部：示意稿风格无色块，标题直接排在页面底色上 -->
  <Style Selector="Border.page-hero">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="20,18" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- 统计卡：白卡 + MD2 投影浮于灰底（示意稿语言），不铺底纹不加色条 -->
  <Style Selector="Border.stat-card">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="16,14" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BoxShadow" Value="0 1px 3px 0 #1F000000, 0 1px 2px 0 #3D000000" />
  </Style>

  <!-- 区块卡：白卡 + MD2 投影（示意稿语言），卡内表格/图表直接坐在白面上 -->
  <Style Selector="Border.section-card">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="18" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BoxShadow" Value="0 1px 3px 0 #1F000000, 0 1px 2px 0 #3D000000" />
  </Style>

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource DapSurfaceBrush}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="18" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BoxShadow" Value="0 1px 3px 0 #1F000000, 0 1px 2px 0 #3D000000" />
  </Style>

  <!-- 图表容器：直接坐在所在白卡上，不再自带底色与描边 -->
  <Style Selector="Border.chart-frame">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Border.chip">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource DapBorderStrongBrush}" />
    <Setter Property="Background" Value="{DynamicResource DapSurfaceMutedBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.chip > TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource DapTextPrimaryBrush}" />
  </Style>

  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource DapBorderBrush}" />
    <Setter Property="Margin" Value="0,12" />
  </Style>

  <Style Selector="Border.empty-state">
    <Setter Property="Padding" Value="32" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- ============ 表单控件 ============ -->
  <Style Selector="TextBox.field, ComboBox.field, CalendarDatePicker.field, NumericUpDown.field">
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- 次操作按钮（刷新 / 导出 / 上一月 / 返回）：白底 + 描边 + 次色文字，
       与 Web 端 Color.Secondary + Variant.Outlined 对应。
       主操作（生成报表 / 登录）才用 Classes="Primary" 的主色填充。 -->
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="{DynamicResource DapSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource DapSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DapBorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- ============ 数据表 ============ -->
  <Style Selector="DataGrid.data-table">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="GridLinesVisibility" Value="None" />
    <Setter Property="HeadersVisibility" Value="Column" />
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="CanUserResizeColumns" Value="True" />
    <Setter Property="RowHeight" Value="34" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="DataGrid.data-table /template/ DataGridColumnHeader">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource DapTextSecondaryBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="DataGrid.data-table DataGridCell">
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- ============ 导航 ============ -->
  <Style Selector="Button.nav-button">
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <Style Selector="Border.nav-item">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Border.nav-item:pointerover">
    <Setter Property="Background" Value="{DynamicResource DapSurfaceSunkenBrush}" />
  </Style>

  <Style Selector="Border.nav-item.active">
    <Setter Property="Background" Value="{DynamicResource DapPrimaryTintBrush}" />
  </Style>

  <Style Selector="TextBlock.nav-text">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource DapTextPrimaryBrush}" />
  </Style>

  <Style Selector="TextBlock.nav-text.active">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource DapPrimaryStrongBrush}" />
  </Style>

  <Style Selector="PathIcon.nav-icon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource DapTextSecondaryBrush}" />
  </Style>

  <Style Selector="PathIcon.nav-icon.active">
    <Setter Property="Foreground" Value="{DynamicResource DapPrimaryStrongBrush}" />
  </Style>

  <Style Selector="Button.module-button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource DapOnPrimaryMutedBrush}" />
  </Style>

  <Style Selector="Button.module-button:pointerover">
    <Setter Property="Background" Value="{DynamicResource DapPrimaryHighlightHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource DapOnPrimaryBrush}" />
  </Style>

  <Style Selector="Button.module-button.active">
    <Setter Property="Background" Value="{DynamicResource DapPrimaryHighlightBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource DapOnPrimaryBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- 左侧色条：仅用于导航选中态与卡片强调，宽度以外边距控制 -->
  <Style Selector="Border.accent-bar">
    <Setter Property="Width" Value="4" />
    <Setter Property="CornerRadius" Value="2" />
  </Style>

</Styles>
