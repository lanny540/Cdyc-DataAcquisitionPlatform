<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DAP.Presentation.AvaloniaApp.ViewModels.Pages"
             x:Class="DAP.Presentation.AvaloniaApp.Views.Pages.SettingsPageView"
             x:DataType="vm:SettingsPageViewModel">
    <Grid RowDefinitions="Auto,*" RowSpacing="18">
        <Border Background="{DynamicResource SurfaceMutedBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="24"
                Padding="18">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel>
                    <TextBlock Text="{Binding SettingsTitle}"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="10">
                    <Button Content="新建"
                            Command="{Binding CreateNewCommand}" />
                    <Button Content="同步到服务端"
                            Command="{Binding SyncCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="360,*" ColumnSpacing="16">
            <Border Background="{DynamicResource SurfaceMutedBrush}"
                    BorderBrush="{DynamicResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="24"
                    Padding="16">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
                    <TextBlock Text="本地采集点编辑器"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}" />

                    <TextBox Grid.Row="1"
                             PlaceholderText="采集点编码"
                             Text="{Binding Code}" />

                    <TextBox Grid.Row="2"
                             PlaceholderText="采集点名称"
                             Text="{Binding Name}" />

                    <TextBox Grid.Row="3"
                             PlaceholderText="采集协议"
                             Text="{Binding Protocol}" />

                    <TextBox Grid.Row="4"
                             PlaceholderText="采集端点"
                             Text="{Binding Endpoint}" />

                    <CheckBox Grid.Row="5"
                              IsChecked="{Binding IsEnabled}"
                              Content="启用该采集点" />

                    <Grid Grid.Row="6" ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Content="保存到本地"
                                Command="{Binding SaveLocalCommand}" />
                        <Button Grid.Column="1"
                                Content="刷新本地"
                                Command="{Binding LoadLocalCommand}" />
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="*,*" RowSpacing="16">
                <Border Background="{DynamicResource SurfaceMutedBrush}"
                        BorderBrush="{DynamicResource SurfaceBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="24"
                        Padding="16">
                    <Grid RowDefinitions="Auto,*" RowSpacing="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <StackPanel>
                                <TextBlock Text="本地 SQLite 配置"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                                <TextBlock Text="选择一条记录即可回填到左侧表单。"
                                           Margin="0,4,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="刷新本地"
                                    Command="{Binding LoadLocalCommand}" />
                        </Grid>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding LocalCollectionPoints}"
                                  SelectedItem="{Binding SelectedLocalPoint}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="All"
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="编码" Binding="{Binding Code}" Width="*" />
                                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="协议" Binding="{Binding Protocol}" Width="*" />
                                <DataGridTextColumn Header="同步状态" Binding="{Binding SyncStatus}" Width="*" />
                                <DataGridTextColumn Header="更新时间" Binding="{Binding UpdatedAt}" Width="1.2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Background="{DynamicResource SurfaceMutedBrush}"
                        BorderBrush="{DynamicResource SurfaceBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="24"
                        Padding="16">
                    <Grid RowDefinitions="Auto,*" RowSpacing="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <StackPanel>
                                <TextBlock Text="服务端采集点快照"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                                <TextBlock Text="用于和本地配置做快速比对。"
                                           Margin="0,4,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="刷新服务端"
                                    Command="{Binding LoadServerCommand}" />
                        </Grid>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding ServerCollectionPoints}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="All"
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="编码" Binding="{Binding Code}" Width="*" />
                                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="协议" Binding="{Binding Protocol}" Width="*" />
                                <DataGridTextColumn Header="通信状态" Binding="{Binding CommunicationStatus}" Width="*" />
                                <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
