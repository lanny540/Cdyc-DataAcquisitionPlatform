<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DAP.Presentation.AvaloniaApp.ViewModels.Pages"
             x:Class="DAP.Presentation.AvaloniaApp.Views.Pages.ShiftCalendarPageView"
             x:DataType="vm:ShiftCalendarPageViewModel">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
        <Border Classes="page-hero" Background="{DynamicResource DapInfoTintBrush}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Spacing="6">
                    <TextBlock Classes="page-title" Text="排班日历" />
                    <TextBlock Classes="page-subtitle" Text="{Binding Description}" />
                    <TextBlock Classes="stat-supporting" Text="{Binding SummaryText}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="ghost" Content="上一月" Command="{Binding PreviousMonthCommand}" />
                    <Border Classes="chip" Background="{DynamicResource DapSurfaceBrush}"
                            Padding="14,6" VerticalAlignment="Center">
                        <TextBlock Text="{Binding MonthText}" FontWeight="SemiBold" />
                    </Border>
                    <Button Classes="ghost" Content="下一月" Command="{Binding NextMonthCommand}" />
                    <Button Classes="ghost" Content="本月" Command="{Binding CurrentMonthCommand}" />
                    <Button Classes="Primary" Content="刷新" Command="{Binding RefreshCommand}"
                            IsEnabled="{Binding IsNotLoading}" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Spacing="8">
            <ProgressBar IsIndeterminate="True" Height="3" IsVisible="{Binding IsLoading}" />
            <Border Classes="panel" Padding="12,10" IsVisible="{Binding HasMessage}"
                    Background="{DynamicResource DapWarningSoftBrush}"
                    BorderBrush="{DynamicResource DapWarningStrongBrush}">
                <TextBlock Classes="table-cell" Text="{Binding Message}" TextWrapping="Wrap"
                           Foreground="{DynamicResource DapWarningStrongBrush}" />
            </Border>
        </StackPanel>

        <Border Grid.Row="2" Classes="panel" Padding="14">
            <StackPanel Spacing="8">
                <UniformGrid Columns="7" Margin="0,0,0,4">
                    <TextBlock Classes="field-label" Text="周一" HorizontalAlignment="Center" />
                    <TextBlock Classes="field-label" Text="周二" HorizontalAlignment="Center" />
                    <TextBlock Classes="field-label" Text="周三" HorizontalAlignment="Center" />
                    <TextBlock Classes="field-label" Text="周四" HorizontalAlignment="Center" />
                    <TextBlock Classes="field-label" Text="周五" HorizontalAlignment="Center" />
                    <TextBlock Classes="field-label" Text="周六" HorizontalAlignment="Center" />
                    <TextBlock Classes="field-label" Text="周日" HorizontalAlignment="Center" />
                </UniformGrid>

                <ItemsControl ItemsSource="{Binding Cells}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7" Rows="6" ColumnSpacing="6" RowSpacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CalendarCellModel">
                            <Border Background="{Binding Background}" CornerRadius="8" Padding="8,6"
                                    BorderThickness="1" BorderBrush="{DynamicResource DapBorderBrush}"
                                    MinHeight="86">
                                <StackPanel Spacing="3">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding DateText}" FontSize="15" FontWeight="Bold"
                                                   Foreground="{DynamicResource DapTextPrimaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding DateLabel}" FontSize="10"
                                                   Foreground="{DynamicResource DapTextSubtleBrush}" />
                                    </Grid>
                                    <TextBlock Text="{Binding OnDuty}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{Binding Accent}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Rest}" FontSize="11" TextWrapping="Wrap"
                                               Foreground="{DynamicResource DapTextSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>