<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:DAP.Presentation.AvaloniaApp.Controls"
             xmlns:vm="using:DAP.Presentation.AvaloniaApp.ViewModels.Pages"
             x:Class="DAP.Presentation.AvaloniaApp.Views.Pages.EnergyHistoryPageView"
             x:DataType="vm:EnergyHistoryPageViewModel">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="14" Margin="0,0,6,6">

      <Border Classes="page-hero">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
          <StackPanel Spacing="6">
            <TextBlock Classes="page-title" Text="班组历史指标" />
            <TextBlock Classes="page-subtitle" Text="{Binding Description}" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
              <Border Classes="chip" Background="{DynamicResource DapSurfaceBrush}">
                <TextBlock Text="{Binding RangeText}" />
              </Border>
              <Border Classes="chip" Background="{DynamicResource DapSurfaceBrush}">
                <TextBlock Text="{Binding PointCountText}" />
              </Border>
            </StackPanel>
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                      VerticalAlignment="Center">
            <StackPanel Spacing="3">
              <TextBlock Classes="field-label" Text="班组" />
              <ComboBox Classes="field" Width="168"
                        ItemsSource="{Binding Teams}"
                        SelectedItem="{Binding SelectedTeam}"
                        PlaceholderText="选择班组" />
            </StackPanel>
            <StackPanel Spacing="3">
              <TextBlock Classes="field-label" Text="统计粒度" />
              <ComboBox Classes="field" Width="118"
                        ItemsSource="{Binding GranularityOptions}"
                        SelectedItem="{Binding SelectedGranularity}" />
            </StackPanel>
            <Button Classes="ghost" Content="刷新" VerticalAlignment="Bottom"
                    Command="{Binding RefreshCommand}"
                    IsEnabled="{Binding IsNotLoading}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- 数据新鲜度与自动刷新：四个能耗页共用的控制条，开关默认关闭 -->
      <Border Classes="panel" Padding="12,8" Background="{DynamicResource DapSurfaceBrush}">
        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
          <TextBlock Classes="timestamp" Text="{Binding LastUpdatedText}"
                     VerticalAlignment="Center" />
          <TextBlock Classes="timestamp" Text="{Binding AutoRefreshHint}"
                     VerticalAlignment="Center" />
          <CheckBox Content="自动刷新" IsChecked="{Binding AutoRefreshEnabled}"
                    VerticalAlignment="Center" />
          <ComboBox Classes="field" Width="110" PlaceholderText="刷新频率"
                    ItemsSource="{Binding RefreshIntervalOptions}"
                    SelectedItem="{Binding SelectedRefreshInterval}"
                    IsEnabled="{Binding AutoRefreshEnabled}" />
        </StackPanel>
      </Border>

      <Border Classes="panel" Padding="12,10" IsVisible="{Binding HasMessage}"
              Background="{DynamicResource DapErrorSoftBrush}"
              BorderBrush="{DynamicResource DapErrorStrongBrush}">
        <TextBlock Classes="table-cell" Text="{Binding Message}" TextWrapping="Wrap"
                   Foreground="{DynamicResource DapErrorStrongBrush}" />
      </Border>

      <ProgressBar IsIndeterminate="True" Height="3" IsVisible="{Binding IsLoading}" />

      <Border Classes="empty-state" Background="{DynamicResource DapSurfaceBrush}"
              IsVisible="{Binding !HasData}">
        <StackPanel Spacing="8" HorizontalAlignment="Center">
          <PathIcon Data="{Binding HeaderIcon}" Width="34" Height="34"
                    Foreground="{DynamicResource DapTertiaryStrongBrush}" />
          <TextBlock Classes="empty-title" Text="暂无历史指标数据" HorizontalAlignment="Center" />
          <TextBlock Classes="empty-text"
                     Text="服务端未能返回该班组的历史指标，请更换班组或稍后重试。" />
        </StackPanel>
      </Border>

      <StackPanel Spacing="14" IsVisible="{Binding HasData}">
        <ItemsControl ItemsSource="{Binding MetricCards}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="4" />
              <!-- 卡片数量固定，等分填满整行，避免固定宽在宽窗口下右侧留白 -->
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:MetricCardModel">
              <Border Classes="stat-card" Background="{Binding Background}"
                      Margin="0,0,12,12">
                <StackPanel Spacing="6">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Width="28" Height="28" CornerRadius="14"
                            Background="{Binding Accent}">
                      <PathIcon Data="{Binding Icon}" Width="15" Height="15"
                                Foreground="{Binding AccentOn}" />
                    </Border>
                    <TextBlock Classes="stat-label" Text="{Binding Label}"
                               VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Classes="stat-value" Text="{Binding Value}" />
                  <TextBlock Classes="stat-supporting" Text="{Binding Supporting}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl ItemsSource="{Binding Trends}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="2" />
              <!-- 图表卡等分两列，随窗口宽度拉伸 -->
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TrendCardModel">
              <Border Classes="section-card" Background="{Binding Background}"
                      BorderBrush="{Binding Accent}" Margin="0,0,12,12">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                      <TextBlock Classes="card-title" Text="{Binding MetricName}" />
                      <TextBlock Classes="card-description" Text="{Binding Subtitle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Center">
                      <Border Classes="chip" Background="{DynamicResource DapSurfaceBrush}">
                        <TextBlock Text="{Binding TotalText}" />
                      </Border>
                      <Border Classes="chip" Background="{DynamicResource DapSurfaceBrush}">
                        <TextBlock Text="{Binding AverageText}" />
                      </Border>
                      <Border Classes="chip" Background="{DynamicResource DapSurfaceBrush}"
                              BorderBrush="{Binding DirectionAccent}">
                        <TextBlock Text="{Binding DirectionLabel}"
                                   Foreground="{Binding DirectionAccent}" />
                      </Border>
                    </StackPanel>
                  </Grid>

                  <Border Classes="chart-frame">
                    <controls:LineTrendChart Height="220"
                                             Points="{Binding Samples}"
                                             Accent="{Binding AccentStrong}"
                                             Unit="{Binding Unit}" />
                  </Border>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Classes="section-card" Background="{DynamicResource DapInfoTintBrush}"
                BorderBrush="{DynamicResource DapInfoBrush}">
          <StackPanel Spacing="10">
            <StackPanel Spacing="2">
              <TextBlock Classes="card-title" Text="历史明细数据" />
              <TextBlock Classes="card-description" Text="{Binding DetailCountText}" />
            </StackPanel>

            <Border Classes="chart-frame" Padding="0">
              <StackPanel>
                <Border Background="{DynamicResource DapInfoTintBrush}" Padding="12,8">
                  <Grid ColumnDefinitions="130,*,*,*,*">
                    <TextBlock Classes="field-label" Text="{Binding PeriodHeader}"
                               Foreground="{DynamicResource DapInfoStrongBrush}" />
                    <TextBlock Grid.Column="1" Classes="field-label"
                               Foreground="{DynamicResource DapInfoStrongBrush}"
                               Text="{Binding Column1}" />
                    <TextBlock Grid.Column="2" Classes="field-label"
                               Foreground="{DynamicResource DapInfoStrongBrush}"
                               Text="{Binding Column2}" />
                    <TextBlock Grid.Column="3" Classes="field-label"
                               Foreground="{DynamicResource DapInfoStrongBrush}"
                               Text="{Binding Column3}" />
                    <TextBlock Grid.Column="4" Classes="field-label"
                               Foreground="{DynamicResource DapInfoStrongBrush}"
                               Text="{Binding Column4}" />
                  </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding PivotRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PivotRowModel">
                      <Border BorderThickness="0,0,0,1"
                              BorderBrush="{DynamicResource DapBorderBrush}"
                              Padding="12,7">
                        <Grid ColumnDefinitions="130,*,*,*,*">
                          <TextBlock Classes="timestamp" Text="{Binding Label}" />
                          <TextBlock Grid.Column="1" Classes="table-primary"
                                     Text="{Binding V1}" />
                          <TextBlock Grid.Column="2" Classes="table-cell" Text="{Binding V2}" />
                          <TextBlock Grid.Column="3" Classes="table-cell" Text="{Binding V3}" />
                          <TextBlock Grid.Column="4" Classes="table-cell" Text="{Binding V4}" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
