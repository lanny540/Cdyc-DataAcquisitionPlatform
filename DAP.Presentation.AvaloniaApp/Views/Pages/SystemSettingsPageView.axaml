<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DAP.Presentation.AvaloniaApp.ViewModels.Pages"
             x:Class="DAP.Presentation.AvaloniaApp.Views.Pages.SystemSettingsPageView"
             x:DataType="vm:SystemSettingsPageViewModel">
    <Grid RowDefinitions="Auto,*" RowSpacing="18">
        <Border Background="{DynamicResource SemiColorBackground1}"
                BorderBrush="{DynamicResource SemiColorBorder}"
                BorderThickness="1"
                Padding="18">
            <StackPanel Spacing="6">
                <TextBlock Text="{Binding PageTitle}"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="{DynamicResource SemiColorText0}" />
                <TextBlock Text="{Binding PageDescription}"
                           Foreground="{DynamicResource SemiColorText1}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="1.15*,0.85*" ColumnSpacing="16">
            <Border Background="{DynamicResource SemiColorBackground1}"
                    BorderBrush="{DynamicResource SemiColorBorder}"
                    BorderThickness="1"
                    Padding="18">
                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="18">
                    <StackPanel Spacing="6">
                        <TextBlock Text="主题与外观"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SemiColorText0}" />
                        <TextBlock Text="在浅色和深色主题之间切换，实时预览整个应用外观。"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SemiColorText1}" />
                    </StackPanel>

                    <Border Grid.Row="1"
                            Background="{DynamicResource SemiColorBackground0}"
                            BorderBrush="{DynamicResource SemiColorBorder}"
                            BorderThickness="1"
                            Padding="16">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <ToggleSwitch IsChecked="{Binding IsDarkTheme}"
                                          OffContent="浅"
                                          OnContent="深"
                                          VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                <TextBlock Text="当前主题"
                                           Foreground="{DynamicResource SemiColorText2}" />
                                <TextBlock Text="{Binding ThemeModeText}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SemiColorText0}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Background="{DynamicResource SemiColorBackground0}"
                            BorderBrush="{DynamicResource SemiColorBorder}"
                            BorderThickness="1"
                            Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="说明"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SemiColorText0}" />
                            <TextBlock Text="主题切换会立即作用于整个客户端窗口，包括主页、采集设置与主导航区域。"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource SemiColorText1}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" Spacing="16">
                <Border Background="{DynamicResource SemiColorBackground1}"
                        BorderBrush="{DynamicResource SemiColorBorder}"
                        BorderThickness="1"
                        Padding="18">
                    <StackPanel Spacing="10">
                        <TextBlock Text="应用信息"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SemiColorText0}" />
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10"
                              RowSpacing="10">
                            <TextBlock Text="名称"
                                       Foreground="{DynamicResource SemiColorText2}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding AppName}"
                                       Foreground="{DynamicResource SemiColorText0}" />

                            <TextBlock Grid.Row="1"
                                       Text="版本"
                                       Foreground="{DynamicResource SemiColorText2}" />
                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       Text="{Binding AppVersion}"
                                       Foreground="{DynamicResource SemiColorText0}" />

                            <TextBlock Grid.Row="2"
                                       Text="技术栈"
                                       Foreground="{DynamicResource SemiColorText2}" />
                            <TextBlock Grid.Row="2"
                                       Grid.Column="1"
                                       Text="{Binding BuildDescription}"
                                       Foreground="{DynamicResource SemiColorText0}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource SemiColorBackground1}"
                        BorderBrush="{DynamicResource SemiColorBorder}"
                        BorderThickness="1"
                        Padding="18">
                    <StackPanel Spacing="10">
                        <TextBlock Text="版权信息"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SemiColorText0}" />
                        <TextBlock Text="{Binding Copyright}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SemiColorText1}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
