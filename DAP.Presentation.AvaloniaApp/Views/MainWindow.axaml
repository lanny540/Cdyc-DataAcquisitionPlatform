<u:UrsaWindow xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:vm="using:DAP.Presentation.AvaloniaApp.ViewModels"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:u="https://irihi.tech/ursa"
              mc:Ignorable="d"
              d:DesignWidth="1920"
              d:DesignHeight="1080"
              x:Class="DAP.Presentation.AvaloniaApp.Views.MainWindow"
              x:DataType="vm:MainWindowViewModel"
              Width="1920"
              Height="1080"
              MinWidth="1920"
              MinHeight="1080"
              MaxWidth="1920"
              MaxHeight="1080"
              Icon="/Assets/avalonia-logo.ico"
              Background="{DynamicResource SemiColorBackground0}"
              Title="CDYC 数据采集平台客户端">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <u:UrsaWindow.Styles>
        <Style Selector="Button.rail-button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Button.submenu-button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Border.rail-item-surface">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Border.rail-item-surface:pointerover">
            <Setter Property="Background" Value="{DynamicResource SemiColorBackground3}" />
        </Style>

        <Style Selector="Border.rail-item-surface.active">
            <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLight}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SemiColorPrimary}" />
        </Style>

        <Style Selector="Border.submenu-item-surface">
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="5,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Border.submenu-item-surface:pointerover">
            <Setter Property="Background" Value="{DynamicResource SemiColorBackground3}" />
        </Style>

        <Style Selector="Border.submenu-item-surface.active">
            <Setter Property="BorderBrush" Value="{DynamicResource SemiColorPrimary}" />
            <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLight}" />
        </Style>

        <Style Selector="PathIcon.submenu-icon">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
        </Style>

        <Style Selector="PathIcon.submenu-icon.active">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorPrimary}" />
        </Style>

        <Style Selector="TextBlock.submenu-text">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
        </Style>

        <Style Selector="TextBlock.submenu-text.active">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorPrimary}" />
        </Style>
    </u:UrsaWindow.Styles>

    <Border Background="{DynamicResource SemiColorBackground0}" Padding="0">
        <Grid RowDefinitions="Auto,*" RowSpacing="0">
            <Border x:Name="TopDragBar"
                    Background="{DynamicResource SemiColorBackground1}"
                    BorderThickness="0,0,0,3"
                    Padding="22,10"
                    BorderBrush="#F59E0B"
                    PointerPressed="TopDragBar_OnPointerPressed">
                <Grid ColumnDefinitions="130,*,130">
                    <Border />

                    <TextBlock Grid.Column="1"
                               Text="CDYC Data Studio"
                               FontSize="16"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SemiColorText0}" />

                    <Border Grid.Column="2" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" ColumnDefinitions="92,Auto,*" ColumnSpacing="0">
                <Border Grid.Column="0"
                        Background="{DynamicResource SemiColorBackground0}"
                        BorderBrush="{DynamicResource SemiColorBorder}"
                        BorderThickness="1"
                        CornerRadius="0"
                        Padding="8,14">
                    <Grid RowDefinitions="*,Auto">
                        <ItemsControl Grid.Row="0"
                                      Margin="0"
                                      ItemsSource="{Binding MenuItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="12" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:MenuItemViewModel">
                                    <Button Classes="rail-button"
                                            HorizontalContentAlignment="Stretch"
                                            Command="{Binding Command}"
                                            CommandParameter="{Binding}">
                                        <Border Classes="rail-item-surface"
                                                Classes.active="{Binding IsSelected}"
                                                CornerRadius="0"
                                                Padding="0,12">
                                            <Grid Width="76"
                                                  RowDefinitions="32,Auto"
                                                  RowSpacing="8"
                                                  HorizontalAlignment="Center">
                                                <PathIcon Width="26"
                                                          Height="26"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Foreground="{DynamicResource SemiColorText2}"
                                                          Data="{Binding Icon}" />
                                                <TextBlock Grid.Row="1"
                                                           Width="76"
                                                           Text="{Binding Header}"
                                                           TextAlignment="Center"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SemiColorText0}" />
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Grid.Row="1"
                                Classes="rail-button"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Command="{Binding SettingsEntry.Command}"
                                CommandParameter="{Binding SettingsEntry}">
                            <Border Classes="rail-item-surface"
                                    Classes.active="{Binding SettingsEntry.IsSelected}"
                                    CornerRadius="0"
                                    Padding="0,12">
                                <Grid Width="76"
                                      RowDefinitions="32,Auto"
                                      RowSpacing="8"
                                      HorizontalAlignment="Center">
                                    <PathIcon Width="26"
                                              Height="26"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Foreground="{DynamicResource SemiColorText2}"
                                              Data="{Binding SettingsEntry.Icon}" />
                                    <TextBlock Grid.Row="1"
                                               Width="76"
                                               Text="{Binding SettingsEntry.Header}"
                                               TextAlignment="Center"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource SemiColorText0}" />
                                </Grid>
                            </Border>
                        </Button>
                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        Width="180"
                        IsVisible="{Binding IsSubmenuVisible}"
                        Background="{DynamicResource SemiColorBackground1}"
                        BorderBrush="{DynamicResource SemiColorBorder}"
                        BorderThickness="1"
                        CornerRadius="0"
                        Padding="10,18">
                    <ItemsControl ItemsSource="{Binding CurrentSubmenuItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:MenuItemViewModel">
                                <Button Classes="submenu-button"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Command="{Binding Command}"
                                        CommandParameter="{Binding}">
                                    <Border Classes="submenu-item-surface"
                                            Classes.active="{Binding IsSelected}"
                                            HorizontalAlignment="Stretch"
                                            Padding="14,12">
                                        <Grid HorizontalAlignment="Stretch"
                                              ColumnDefinitions="20,*"
                                              ColumnSpacing="12">
                                            <PathIcon Classes="submenu-icon"
                                                      Classes.active="{Binding IsSelected}"
                                                      Width="16"
                                                      Height="16"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      Data="{Binding Icon}" />
                                            <TextBlock Grid.Column="1"
                                                       Classes="submenu-text"
                                                       Classes.active="{Binding IsSelected}"
                                                       Text="{Binding Header}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Left"
                                                       TextAlignment="Left"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding Header}" />
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <Border Grid.Column="2"
                        Background="{DynamicResource SemiColorBackground0}"
                        BorderBrush="{DynamicResource SemiColorBorder}"
                        BorderThickness="1"
                        CornerRadius="0"
                        Padding="18"
                        BoxShadow="0 20 60 0 #160F172A">
                    <TransitioningContentControl Content="{Binding CurrentPage}" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</u:UrsaWindow>
