<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DAP.Presentation.AvaloniaApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="DAP.Presentation.AvaloniaApp.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="CDYC 数据采集平台客户端">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <SplitView IsPaneOpen="True" 
               DisplayMode="Inline" 
               OpenPaneLength="220" 
               Background="#F3F4F6" 
               PaneBackground="#FFFFFF">
        <SplitView.Pane>
            <Grid RowDefinitions="Auto,*">
                <!-- Logo / Title Area -->
                <TextBlock Grid.Row="0" 
                           Text="数据采集平台" 
                           FontWeight="Bold" 
                           FontSize="18" 
                           Margin="20,20,20,20" 
                           Foreground="#1F2937"/>
                
                <!-- Navigation Menu -->
                <TreeView Grid.Row="1" 
                          ItemsSource="{Binding MenuItems}" 
                          BorderThickness="0" 
                          Background="Transparent"
                          Margin="10,0">
                    <TreeView.DataTemplates>
                        <TreeDataTemplate DataType="vm:MenuItemViewModel" ItemsSource="{Binding Children}">
                            <Button Command="{Binding Command}" 
                                    CommandParameter="{Binding TargetPage}"
                                    Background="Transparent" 
                                    BorderThickness="0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <!-- Use PathIcon for beautiful SVG icons -->
                                    <PathIcon Data="{Binding Icon}" Width="16" Height="16" Foreground="#6B7280" />
                                    <TextBlock Text="{Binding Header}" VerticalAlignment="Center" Foreground="#374151"/>
                                </StackPanel>
                            </Button>
                        </TreeDataTemplate>
                    </TreeView.DataTemplates>
                </TreeView>
            </Grid>
        </SplitView.Pane>

        <SplitView.Content>
            <Border Background="#FFFFFF" 
                    CornerRadius="8" 
                    Margin="10" 
                    BoxShadow="0 4 8 0 #1A000000">
                <TransitioningContentControl Content="{Binding CurrentPage}" />
            </Border>
        </SplitView.Content>
    </SplitView>

</Window>
