<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DAP.Presentation.AvaloniaApp.App"
             xmlns:local="using:DAP.Presentation.AvaloniaApp"
             xmlns:semi="https://irihi.tech/semi"
             RequestedThemeVariant="Default">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <!-- 平台统一品牌色板：全项目配色的唯一权威来源，详见 docs/DESIGN_SYSTEM.md。
             品牌色覆盖与 Semi 主题同处 Application.Resources：Semi 控件通过
             DynamicResource 取色，此处优先级高于主题默认调色板，可在不改动
             Semi 主题源码的前提下替换为平台品牌色。 -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://DAP.Presentation.AvaloniaApp/Themes/DapPalette.axaml" />
                <ResourceInclude Source="avares://DAP.Presentation.AvaloniaApp/Themes/SemiBrandOverride.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <semi:SemiTheme Locale="zh-CN" />
        <semi:UrsaSemiTheme Locale="zh-CN" />
        <StyleInclude Source="avares://Semi.Avalonia.DataGrid/Index.axaml" />
    </Application.Styles>
</Application>
